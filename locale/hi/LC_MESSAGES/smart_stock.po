msgid "No document available"
msgstr "कोई दस्तावेज़ उपलब्ध नहीं"

#: smart_stock/dialogs/stock_detection_dialog.py
#, python-brace-format
msgid "Stock {num}"
msgstr "स्टॉक {num}"

#: smart_stock/dialogs/stock_detection_dialog.py
#, python-brace-format
msgid "Stock Item {num}"
msgstr "स्टॉक आइटम {num}"

#: smart_stock/dialogs/stock_detection_dialog.py
#, python-brace-format
msgid "Created {count} stock items"
msgstr "{count} स्टॉक आइटम बनाए गए"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Error"
msgstr "त्रुटि"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "No camera available"
msgstr "कोई कैमरा उपलब्ध नहीं"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Machine work area unknown"
msgstr "मशीन कार्य क्षेत्र अज्ञात"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Failed to capture aligned image"
msgstr "संरेखित छवि कैप्चर करने में विफलता"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Reference captured - Ready"
msgstr "संदर्भ कैप्चर हुआ - तैयार"

#: smart_stock/widgets/reference_capture_group.py
msgid "Smart Stock Reference"
msgstr "स्मार्ट स्टॉक संदर्भ"

#: smart_stock/widgets/reference_capture_group.py
msgid "Capture reference image for stock detection"
msgstr "स्टॉक पहचान के लिए संदर्भ छवि कैप्चर करें"

#: smart_stock/widgets/reference_capture_group.py
msgid "Selected Camera"
msgstr "चयनित कैमरा"

#: smart_stock/widgets/reference_capture_group.py
msgid "Capture current camera view as reference"
msgstr "वर्तमान कैमरा दृश्य को संदर्भ के रूप में कैप्चर करें"

#: smart_stock/widgets/reference_capture_group.py
msgid "Clear Reference"
msgstr "संदर्भ साफ़ करें"

#: smart_stock/widgets/reference_capture_group.py
msgid "Remove stored reference image"
msgstr "संग्रहीत संदर्भ छवि हटाएँ"

#: smart_stock/widgets/reference_capture_group.py
msgid "Clear"
msgstr "साफ़ करें"

#: smart_stock/widgets/reference_capture_group.py
msgid "No reference captured"
msgstr "कोई संदर्भ कैप्चर नहीं"

#: smart_stock/widgets/reference_capture_group.py
msgid "Unknown"
msgstr "अज्ञात"

#: smart_stock/widgets/reference_capture_group.py
msgid "Just now"
msgstr "अभी"

#: smart_stock/widgets/reference_capture_group.py
#, python-brace-format
msgid "Reference captured {time}"
msgstr "संदर्भ {time} कैप्चर हुआ"

#: smart_stock/widgets/reference_capture_group.py
msgid "Cannot capture: machine work area unknown"
msgstr "कैप्चर नहीं कर सकते: मशीन कार्य क्षेत्र अज्ञात"

#: smart_stock/frontend.py
msgid "Detect Stock from Camera..."
msgstr "कैमरे से स्टॉक पहचानें..."
