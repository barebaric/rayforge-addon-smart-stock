#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Stock Detection"
msgstr "स्टॉक पहचान"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Close"
msgstr "बंद करें"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Create Stock Items"
msgstr "स्टॉक आइटम बनाएँ"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Detection Settings"
msgstr "पहचान सेटिंग्स"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Camera"
msgstr "कैमरा"

#: smart_stock/dialogs/stock_detection_dialog.py
