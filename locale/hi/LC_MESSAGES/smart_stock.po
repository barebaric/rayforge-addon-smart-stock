msgid "Reference loaded - Ready"
msgstr "संदर्भ लोड है - तैयार"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "No reference - Click 'Capture Reference' to capture one"
msgstr "कोई संदर्भ नहीं - कैप्चर करने के लिए 'संदर्भ कैप्चर करें' पर क्लिक करें"

#: smart_stock/dialogs/stock_detection_dialog.py
msgid "Not found"
msgstr "नहीं मिला"

